    "@neon/auth": "0.8.2",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.73.0",
    "music-metadata": "12.3.2",
