    "build:cloudflare": "node scripts/prepare-cloudflare.mjs",
    "test:cloudflare": "node --test tests/server/cloudflare-*.test.mjs",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc"
  },
