{
  "id": "/",
  "name": "Pulso · Tu música",
  "short_name": "Pulso",
  "lang": "es",
  "description": "Tu música, álbumes y playlists en este navegador.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
