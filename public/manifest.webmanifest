    {"src": "/icons/pulso-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/pulso-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
